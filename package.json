{
  "name": "kindlewake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5175",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "atlas": "node tools/build-icons.mjs && node tools/build-atlas.mjs tools/manifest.json public/atlas",
    "backgrounds": "node tools/build-backgrounds.mjs",
    "audio": "node tools/build-audio.mjs",
    "assets": "npm run atlas && npm run backgrounds && npm run audio"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
